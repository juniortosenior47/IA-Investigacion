{
  "name": "nest-idcs-redis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node -r ts-node/register/transpile-only src/main.ts",
    "start:dev": "nodemon --watch src -e ts --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint '{src,test}/**/*.{ts,js}' --fix",
    "test": "mocha -r ts-node/register 'test/**/*.spec.ts'",
    "test:watch": "mocha -r ts-node/register --watch 'test/**/*.spec.ts'"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "axios": "^1.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "dotenv-safe": "^8.2.0",
    "ioredis": "^5.8.2",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express": "^5.0.5",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chai": "^4.3.7",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.5.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.0",
    "sinon": "^15.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0",
    "nodemon": "^3.0.0"
  }
}
